@startuml
skinparam roundcorner 5
skinparam shadowing false

entity "User" as user {
  * id : INT <<PK>>
  --
  * email : VARCHAR <<Чутливі дані>>
  * password_hash : VARCHAR <<Чутливі дані>>
  * role : ENUM (Player, Master, Admin)
  contacts : VARCHAR <<Чутливі дані>>
  avatar_url : VARCHAR
  is_blocked : BOOLEAN
  failed_login_attempts : INT
}

entity "Session" as session {
  * id : VARCHAR <<PK>>
  --
  * user_id : INT <<FK>>
  * expires_at : DATETIME
}

entity "Room" as room {
  * id : INT <<PK>>
  --
  * name : VARCHAR
  capacity : INT
  is_blocked : BOOLEAN
}

entity "Booking" as booking {
  * id : INT <<PK>>
  --
  * room_id : INT <<FK>>
  * start_time : DATETIME
  * end_time : DATETIME
  status : VARCHAR
}

entity "Game" as game {
  * id : INT <<PK>>
  --
  * master_id : INT <<FK>>
  * room_id : INT <<FK>>
  * title : VARCHAR
  * start_time : DATETIME
  * duration_minutes : INT
  max_players : INT
}

entity "GameEnrollment" as enrollment {
  * id : INT <<PK>>
  --
  * game_id : INT <<FK>>
  * player_id : INT <<FK>>
  enrolled_at : DATETIME
}

entity "Notification" as notification {
  * id : INT <<PK>>
  --
  * user_id : INT <<FK>>
  * message : TEXT
  is_read : BOOLEAN
  created_at : DATETIME
}

user ||--o{ game : "Створює (як Майстер)"
room ||--o{ game : "Хостить"
user ||--o{ enrollment : "Бере участь"
game ||--o{ enrollment : "Має гравців"
user ||--o{ session : "Має сесії"
room ||--o{ booking : "Має бронювання"
user ||--o{ notification : "Отримує"

@enduml
@startuml
skinparam componentStyle uml2

package "Frontend Layer" {
  component "Web Client (Jinja2 + HTMX)" as Client
}

node "Cloud Infrastructure (Nginx/Reverse Proxy)" as Cloud {
  package "Backend System (FastAPI Monolith)" {
    component "Auth & Routing\nController" as Auth
    component "Game Management\nService" as GameSvc
    component "Room Booking\nService" as RoomSvc
    component "Notification Service" as NotifSvc
  }
}

database "Relational DB (MySQL)" as DB
cloud "External SMTP Server" as SMTP

Client --> Cloud : HTTP (HTMX AJAX)
Cloud --> Auth : Маршрутизація трафіку
Auth --> GameSvc : Виклик функції
Auth --> RoomSvc : Виклик функції
GameSvc --> DB : SQL (Читання/Запис)
RoomSvc --> DB : SQL (Транзакції бронювання)
Auth --> Client : Повертає HTML-фрагменти

GameSvc --> NotifSvc : Тригер сповіщення (FR-011)
NotifSvc --> SMTP : Відправка Email
SMTP --> Client : Лист гравцю про скасування

note right of DB
  Гарантує ACID транзакції
  для уникнення овербукінгу кімнат
end note
@enduml
